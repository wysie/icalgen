{
  "name": "icalgen",
  "version": "1.0.0",
  "private": true,
  "description": "Static iCalendar (.ics) file and Google Calendar link generator",
  "scripts": {
    "dev": "vite app --host 0.0.0.0",
    "build": "vite build app --outDir ../dist --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run build && npm run smoke"
  },
  "devDependencies": {
    "puppeteer-core": "^24.31.0",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=20"
  }
}
